<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Miti" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash de arranque (Figma, "Splash Screen"): logo sobre el petróleo primario.
         Usa la SplashScreen API, que en Android 12+ es la del sistema y en versiones
         anteriores la emula la librería; al terminar pasa a Theme.Miti. -->
    <style name="Theme.Miti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/miti_petroleo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Miti</item>
    </style>
</resources>
